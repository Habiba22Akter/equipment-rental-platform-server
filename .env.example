# MongoDB Atlas connection string. Keep credentials in your local .env only.
DB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=equipment-rental-platform

# Express server
PORT=5001

# Comma-separated browser origins allowed to call this API.
CLIENT_ORIGIN=http://localhost:3000

# Optional shared secret. When set, the Next.js server must send it as
# x-api-key on POST/PATCH/DELETE requests. Leave empty for local-only setups.
INTERNAL_API_KEY=

# Better Auth URL used to fetch the JWT public keys (JWKS).
BETTER_AUTH_URL=http://localhost:3000
# Optional override if the JWKS endpoint is hosted at a custom URL.
JWT_JWKS_URL=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CLIENT_URL=http://localhost:3000
# Approximate exchange rate: BDT for 1 USD. Change this when needed.
BDT_PER_USD=120
